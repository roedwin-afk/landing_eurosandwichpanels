---
// src/components/layout/Navbar.astro
import type { TranslationKeys } from '../../i18n/en';
import type { Lang } from '../../i18n/utils';
import NavLinks from '../ui/NavLinks.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  t: TranslationKeys;
  lang: Lang;
  alternateURL: string;
}

const { t, lang, alternateURL } = Astro.props;

const base = import.meta.env.BASE_URL; // "/landing_eurosandwichpanels/"

// Logo: raíz del idioma actual
const logoHref = lang === 'es' ? `${base}es/` : base;

// Switcher: el activo apunta a sí mismo, el inactivo apunta al alternate
const enURL = lang === 'en' ? base : alternateURL;
const esURL = lang === 'es' ? `${base}es/` : alternateURL;

// CTA
const ctaHref = lang === 'es' ? `${base}es/#sample-builder` : `${base}#sample-builder`;
---

<header class="navbar">
  <div class="container navbar__inner">

    <!-- Logo -->
    <a href={logoHref} class="navbar__logo" aria-label="Euro Sandwich Panels Home">
      <div class="navbar__logo-icon">
        <span class="navbar__logo-e">E</span>SP
      </div>
      <div class="navbar__logo-text">
        <span class="navbar__logo-name">Euro Sandwich Panels</span>
        <span class="navbar__logo-sub">Quality Insulation</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="navbar__nav" aria-label="Main navigation">
      <NavLinks t={t} lang={lang} orientation="horizontal" />
    </nav>

    <!-- Right side: langs + CTA + hamburger -->
    <div class="navbar__actions">

      <!-- Language switcher (desktop) -->
      <div class="navbar__langs">
        
        <a  href={enURL}
          class:list={['navbar__lang', lang === 'en' && 'navbar__lang--active']}
          aria-label="Switch to English"
        >
          EN
        </a>
        <span class="navbar__lang-sep">|</span>
        
        <a  href={esURL}
          class:list={['navbar__lang', lang === 'es' && 'navbar__lang--active']}
          aria-label="Cambiar a Español"
        >
          ES
        </a>
      </div>

      <!-- CTA Button (desktop) -->
      <a href={ctaHref} class="navbar__cta">
        {t.nav.quote}
      </a>

      <!-- Hamburger (mobile) -->
      <button
        id="mobile-menu-btn"
        class="navbar__hamburger"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="navbar__hamburger-bar"></span>
        <span class="navbar__hamburger-bar"></span>
        <span class="navbar__hamburger-bar"></span>
      </button>

    </div>
  </div>

  <!-- Mobile Menu -->
  <MobileMenu t={t} lang={lang} alternateURL={alternateURL} />
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-xs);
  }

  .navbar__inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .navbar__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    transition: opacity var(--transition);
  }

  .navbar__logo:hover { opacity: 0.85; }

  .navbar__logo-icon {
    height: 2.5rem;
    width: 2.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    font-weight: 700;
    font-size: var(--text-lg);
    flex-shrink: 0;
  }

  .navbar__logo-e { color: var(--color-accent); }

  .navbar__logo-name {
    display: block;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .navbar__logo-sub {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-top: -2px;
  }

  .navbar__nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .navbar__nav { display: flex; }
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .navbar__langs {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .navbar__langs { display: flex; }
  }

  .navbar__lang {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-steel);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }

  .navbar__lang:hover { color: var(--color-primary); }

  .navbar__lang--active {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .navbar__lang-sep {
    color: var(--color-border);
    font-size: var(--text-xs);
  }

  .navbar__cta {
    display: none;
    background-color: var(--color-accent);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-md);
    letter-spacing: 0.03em;
    box-shadow: var(--shadow-xs);
    transition: background-color var(--transition);
    white-space: nowrap;
  }

  .navbar__cta:hover { background-color: var(--color-accent-hover); }

  @media (min-width: 640px) {
    .navbar__cta { display: block; }
  }

  .navbar__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition);
  }

  .navbar__hamburger:hover { background-color: var(--color-bg); }

  .navbar__hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-steel);
    border-radius: 2px;
    transition: all var(--transition);
  }

  @media (min-width: 768px) {
    .navbar__hamburger { display: none; }
  }
</style>