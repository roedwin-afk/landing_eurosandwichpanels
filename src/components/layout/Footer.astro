---
// src/components/layout/Footer.astro
import type { TranslationKeys } from '../../i18n/en';
import type { Lang } from '../../i18n/utils';
import NavLinks from '../ui/NavLinks.astro';

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = lang === 'es' ? '/es' : '';
---

<footer class="footer">
  <div class="container">

    <!-- Top grid -->
    <div class="footer__grid">

      <!-- Col 1: Brand -->
      <div class="footer__brand">
        <a href={`${base}/`} class="footer__logo" aria-label="Euro Sandwich Panels">
          <div class="footer__logo-icon">
            <span class="footer__logo-e">E</span>SP
          </div>
          <span class="footer__logo-name">Euro Sandwich Panels</span>
        </a>

        <p class="footer__tagline">{t.footer.tagline}</p>

        <div class="footer__socials">
          <a href="#" class="footer__social" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a href="#" class="footer__social" aria-label="X / Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"/>
            </svg>
          </a>
          <a href="#" class="footer__social" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Nav Links -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t.nav.what.split('?')[0]}</h4>
        <NavLinks t={t} lang={lang} orientation="vertical" />
      </div>

      <!-- Col 3: Engineering Cores -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t.footer.cols.cores.title}</h4>
        <ul class="footer__links">
          {t.footer.cols.cores.links.map((link) => (
            <li>
              <a href={`${base}/${link.href}`} class="footer__link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Technical Tools -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t.footer.cols.tools.title}</h4>
        <ul class="footer__links">
          {t.footer.cols.tools.links.map((link) => (
            <li>
              <a href={`${base}/${link.href}`} class="footer__link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 5: Standards -->
      <div class="footer__col">
        <h4 class="footer__col-title">{t.footer.cols.standards.title}</h4>
        <p class="footer__standards-desc">{t.footer.cols.standards.desc}</p>
        <span class="footer__badge">{t.footer.cols.standards.badge}</span>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="footer__bottom">
      <span class="footer__copyright">{t.footer.legal.copyright}</span>
      <div class="footer__legal-links">
        <a href="#" class="footer__legal-link">{t.footer.legal.imprint}</a>
        <span class="footer__legal-sep">|</span>
        <a href="#" class="footer__legal-link">{t.footer.legal.privacy}</a>
        <span class="footer__legal-sep">|</span>
        <a href="#" class="footer__legal-link">{t.footer.legal.cookies}</a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ── Grid ── */
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 2fr 1.5fr 1fr 1fr 1fr;
    }
  }

  /* ── Brand col ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    transition: opacity var(--transition);
  }

  .footer__logo:hover {
    opacity: 0.85;
  }

  .footer__logo-icon {
    height: 2rem;
    width: 2rem;
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .footer__logo-e {
    color: var(--color-accent);
  }

  .footer__logo-name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
  }

  .footer__socials {
    display: flex;
    gap: var(--space-3);
  }

  .footer__social {
    color: rgba(255, 255, 255, 0.4);
    transition: color var(--transition);
    display: flex;
    align-items: center;
  }

  .footer__social:hover {
    color: var(--color-accent);
  }

  /* ── Cols ── */
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col-title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition);
    line-height: 1.6;
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  /* Override NavLinks styles inside footer */
  .footer__col :global(.nav-link) {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    padding-block: var(--space-1);
    padding-inline: 0;
    background: none !important;
  }

  .footer__col :global(.nav-link:hover) {
    color: var(--color-accent);
  }

  .footer__col :global(.nav-links--vertical) {
    gap: var(--space-2);
  }

  /* ── Standards col ── */
  .footer__standards-desc {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
  }

  .footer__badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── Bottom bar ── */
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
  }

  .footer__legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__legal-link {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
    transition: color var(--transition);
  }

  .footer__legal-link:hover {
    color: var(--color-accent);
  }

  .footer__legal-sep {
    color: rgba(255, 255, 255, 0.1);
    font-size: var(--text-xs);
  }
</style>