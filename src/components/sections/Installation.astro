---
import type { TranslationKeys } from '../../i18n/en';
import type { Lang } from '../../i18n/utils';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { TriangleAlert, CheckCircle } from 'lucide-astro';

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t } = Astro.props;
---

<!-- Hero -->
<section class="installation-hero">
  <div class="container">
    <ScrollReveal>
      <span class="section-eyebrow">{t.installation.hero.eyebrow}</span>
    </ScrollReveal>
    <ScrollReveal delay={1}>
      <h1 class="installation-hero__title">{t.installation.hero.title}</h1>
    </ScrollReveal>
    <ScrollReveal delay={2}>
      <p class="installation-hero__subtitle">{t.installation.hero.subtitle}</p>
    </ScrollReveal>
  </div>
</section>

<!-- Timeline -->
<section class="installation section">
  <div class="container">
    <div class="installation__timeline">
      {t.installation.steps.map((step, i) => (
        <ScrollReveal class="installation__step" delay={(i % 3) as 0 | 1 | 2 | 3}>

          <!-- Número + conector vertical -->
          <div class="installation__step-aside">
            <div class="installation__step-number">{step.number}</div>
            {i < t.installation.steps.length - 1 && (
              <div class="installation__step-connector" />
            )}
          </div>

          <!-- Contenido -->
          <div class="installation__step-body">
            <h2 class="installation__step-title">{step.title}</h2>
            <p class="installation__step-desc">{step.desc}</p>

            <ul class="installation__step-details">
              {step.details.map((detail) => (
                <li class="installation__step-detail">
                  <CheckCircle size={14} strokeWidth={2.5} />
                  {detail}
                </li>
              ))}
            </ul>

            <div class="installation__step-warning">
              <TriangleAlert size={14} />
              <span>{step.warning}</span>
            </div>
          </div>

        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<!-- Errors -->
<section class="installation-errors section">
  <div class="container">

    <div class="section-header">
      <ScrollReveal>
        <span class="section-eyebrow">{t.installation.errors.eyebrow}</span>
      </ScrollReveal>
      <ScrollReveal delay={1}>
        <h2 class="section-title">{t.installation.errors.title}</h2>
      </ScrollReveal>
      <ScrollReveal delay={2}>
        <p class="section-subtitle">{t.installation.errors.subtitle}</p>
      </ScrollReveal>
    </div>

    <div class="installation-errors__grid">
      {t.installation.errors.items.map((item, i) => (
        <ScrollReveal delay={(i % 3) as 0 | 1 | 2 | 3}>
          <article class="installation-errors__card">
            <div class="installation-errors__card-number">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="installation-errors__card-title">{item.title}</h3>
            <p class="installation-errors__card-desc">{item.desc}</p>
          </article>
        </ScrollReveal>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Hero ── */
  .installation-hero {
    background-color: var(--color-white);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .installation-hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: var(--space-4);
    max-width: 48rem;
  }

  .installation-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 40rem;
    margin-top: var(--space-4);
  }

  /* ── Timeline section ── */
  .installation {
    background-color: var(--color-bg);
  }

  /* ── Timeline ── */
  .installation__timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ── Step ── */
  .installation__step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .installation__step {
      grid-template-columns: 4rem 1fr;
      gap: var(--space-8);
    }
  }

  /* ── Aside: número + conector ── */
  .installation__step-aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .installation__step-number {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 700;
    font-family: monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .installation__step-connector {
    width: 2px;
    flex: 1;
    min-height: var(--space-8);
    background-color: var(--color-border);
    margin-block: var(--space-2);
  }

  /* ── Step body ── */
  .installation__step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-10);
  }

  .installation__step-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
    padding-top: var(--space-2);
  }

  .installation__step-desc {
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.8;
  }

  /* ── Detail bullets ── */
  .installation__step-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .installation__step-detail {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.6;
  }

  .installation__step-detail svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── Warning ── */
  .installation__step-warning {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: rgba(224, 123, 57, 0.06);
    border: 1px solid rgba(224, 123, 57, 0.2);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-accent);
    line-height: 1.6;
    font-weight: 500;
  }

  .installation__step-warning svg {
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ── Errors section ── */
  .installation-errors {
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  /* ── Errors grid ── */
  .installation-errors__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .installation-errors__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .installation-errors__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Error card ── */
  .installation-errors__card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: box-shadow var(--transition-slow), transform var(--transition-slow);
  }

  .installation-errors__card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .installation-errors__card-number {
    font-size: var(--text-xs);
    font-weight: 700;
    font-family: monospace;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .installation-errors__card-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.4;
  }

  .installation-errors__card-desc {
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.7;
  }
</style>