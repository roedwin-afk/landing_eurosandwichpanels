---
// src/components/sections/Technical.astro
import type { TranslationKeys } from '../../i18n/en';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { Thermometer, Wind, Droplets, ListChecks, Info } from 'lucide-astro';

interface Props {
  t: TranslationKeys;
}

const { t } = Astro.props;

const icons = [Thermometer, Wind, Droplets];
---

<section id="technical" class="technical section">
  <div class="container">
    <div class="technical__layout">

      <!-- Left: content -->
      <div class="technical__copy">

        <ScrollReveal>
          <span class="section-eyebrow">{t.technical.eyebrow}</span>
        </ScrollReveal>

        <ScrollReveal delay={1}>
          <h2 class="section-title">{t.technical.title}</h2>
        </ScrollReveal>

        <ScrollReveal delay={2}>
          <p class="technical__intro">{t.technical.intro}</p>
        </ScrollReveal>

        <div class="technical__items">
          {t.technical.items.map((item, i) => {
            const Icon = icons[i] ?? Thermometer;
            return (
              <ScrollReveal delay={(i % 3) as 0 | 1 | 2 | 3}>
                <div class="technical__item">
                  <div class="technical__item-icon">
                    <Icon size={16} />
                  </div>
                  <div class="technical__item-body">
                    <h4 class="technical__item-title">{item.title}</h4>
                    <p class="technical__item-desc">{item.desc}</p>
                  </div>
                </div>
              </ScrollReveal>
            );
          })}
        </div>

      </div>

      <!-- Right: reference table -->
      <ScrollReveal class="technical__table-wrap" delay={2}>
        <div class="technical__table-card">

          <h3 class="technical__table-title">
            <ListChecks size={18} />
            {t.technical.tableTitle}
          </h3>

          <ul class="technical__table">
            {t.technical.rows.map((row) => (
              <li class="technical__row">
                <span class="technical__row-label">{row.label}</span>
                <span class="technical__row-value">{row.value}</span>
              </li>
            ))}
          </ul>

          <!-- Note -->
          <div class="technical__note">
            <Info size={14} />
            <p>
              <strong>{t.technical.tableNoteLabel}</strong>{' '}
              {t.technical.tableNote}
            </p>
          </div>

        </div>
      </ScrollReveal>

    </div>
  </div>
</section>

<style>
  .technical {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  /* ── Layout ── */
  .technical__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .technical__layout {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Copy ── */
  .technical__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .technical__intro {
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.8;
  }

  /* ── Items ── */
  .technical__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .technical__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .technical__item-icon {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    background-color: rgba(28, 53, 87, 0.08);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .technical__item-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .technical__item-desc {
    font-size: var(--text-xs);
    color: var(--color-steel);
    line-height: 1.8;
  }

  /* ── Table card ── */
  .technical__table-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .technical__table-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .technical__table-title :global(svg) {
    color: var(--color-accent);
  }

  /* ── Table rows ── */
  .technical__table {
    display: flex;
    flex-direction: column;
  }

  .technical__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-4);
  }

  .technical__row:last-child {
    border-bottom: none;
  }

  .technical__row-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-steel);
  }

  .technical__row-value {
    font-family: monospace;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Note ── */
  .technical__note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: rgba(28, 53, 87, 0.04);
    border: 1px solid rgba(28, 53, 87, 0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .technical__note :global(svg) {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .technical__note p {
    font-size: var(--text-xs);
    color: var(--color-steel);
    line-height: 1.7;
  }

  .technical__note strong {
    color: var(--color-primary);
  }
</style>