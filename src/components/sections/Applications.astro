---
import type { TranslationKeys } from '../../i18n/en';
import type { Lang } from '../../i18n/utils';
import ScrollReveal from '../ui/ScrollReveal.astro';
import { CheckCircle } from 'lucide-astro';

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t } = Astro.props;

type SectorKey = 'cold' | 'logistics' | 'food' | 'office' | 'agriculture';
const sectorKeys: SectorKey[] = ['cold', 'logistics', 'food', 'office', 'agriculture'];
---

<!-- Hero -->
<section class="applications-hero">
  <div class="container">
    <ScrollReveal>
      <span class="section-eyebrow">{t.applications.hero.eyebrow}</span>
    </ScrollReveal>
    <ScrollReveal delay={1}>
      <h1 class="applications-hero__title">{t.applications.hero.title}</h1>
    </ScrollReveal>
    <ScrollReveal delay={2}>
      <p class="applications-hero__subtitle">{t.applications.hero.subtitle}</p>
    </ScrollReveal>
  </div>
</section>

<!-- Sectors -->
<section class="applications section">
  <div class="container">
    <div class="applications__layout">

      <!-- Sidebar tabs -->
      <ScrollReveal class="applications__sidebar">
        <div class="applications__tabs">
          {sectorKeys.map((key, i) => (
            <button
              class:list={['applications__tab', i === 0 && 'applications__tab--active']}
              data-tab={key}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {t.applications.sectors[key].label}
            </button>
          ))}
        </div>
      </ScrollReveal>

      <!-- Detail panels -->
      <ScrollReveal class="applications__panels" delay={1}>
        {sectorKeys.map((key, i) => {
          const s = t.applications.sectors[key];
          return (
            <div
              class:list={['applications__panel', i === 0 && 'applications__panel--active']}
              data-panel={key}
            >
              <!-- Header -->
              <div class="applications__panel-header">
                <h2 class="applications__panel-title">{s.title}</h2>
              </div>

              <!-- Description -->
              <p class="applications__panel-desc">{s.desc}</p>

              <!-- Metrics -->
              <div class="applications__metrics">
                <div class="applications__metric">
                  <span class="applications__metric-label">Recommended Panel</span>
                  <span class="applications__metric-value">{s.panel}</span>
                </div>
                <div class="applications__metric">
                  <span class="applications__metric-label">Typical Thickness</span>
                  <span class="applications__metric-value">{s.thickness}</span>
                </div>
                <div class="applications__metric">
                  <span class="applications__metric-label">Target U-Value</span>
                  <span class="applications__metric-value">{s.uvalue}</span>
                </div>
              </div>

              <!-- Why this core -->
              <div class="applications__why">
                <h4 class="applications__why-title">Why this core?</h4>
                <p class="applications__why-desc">{s.why}</p>
              </div>

              <!-- Specs -->
              <ul class="applications__specs">
                {s.specs.map((spec) => (
                  <li class="applications__spec">
                    <CheckCircle size={14} strokeWidth={2.5} />
                    {spec}
                  </li>
                ))}
              </ul>

            </div>
          );
        })}
      </ScrollReveal>

    </div>
  </div>
</section>

<style>
  /* ── Hero ── */
  .applications-hero {
    background-color: var(--color-white);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }

  .applications-hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: var(--space-4);
    max-width: 48rem;
  }

  .applications-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 40rem;
    margin-top: var(--space-4);
  }

  /* ── Section ── */
  .applications {
    background-color: var(--color-bg);
  }

  /* ── Layout ── */
  .applications__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .applications__layout {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }

  /* ── Tabs ── */
  .applications__tabs {
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-2);
  }

  @media (min-width: 1024px) {
    .applications__tabs {
      flex-direction: column;
      overflow-x: visible;
      padding-bottom: 0;
    }
  }

  .applications__tab {
    flex-shrink: 0;
    text-align: left;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-steel);
    cursor: pointer;
    transition: all var(--transition-slow);
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .applications__tab {
      white-space: normal;
      padding: var(--space-4) var(--space-5);
    }
  }

  .applications__tab:hover:not(.applications__tab--active) {
    border-color: var(--color-accent);
    color: var(--color-primary);
    background-color: var(--color-bg);
  }

  .applications__tab--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  /* ── Panels ── */
  .applications__panel {
    display: none;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    animation: fadeIn 0.25s ease;
  }

  .applications__panel--active {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Panel header ── */
  .applications__panel-header {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .applications__panel-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
  }

  /* ── Description ── */
  .applications__panel-desc {
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.8;
  }

  /* ── Metrics ── */
  .applications__metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 480px) {
    .applications__metrics {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .applications__metric {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .applications__metric-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .applications__metric-value {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
  }

  /* ── Why ── */
  .applications__why {
    background-color: rgba(28, 53, 87, 0.04);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .applications__why-title {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .applications__why-desc {
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.8;
  }

  /* ── Specs ── */
  .applications__specs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .applications__spec {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-steel);
    line-height: 1.6;
  }

  .applications__spec svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>

<script>
  function initApplications() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.applications__tab');
    const panels = document.querySelectorAll<HTMLElement>('.applications__panel');

    if (!tabs.length || !panels.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.tab;

        tabs.forEach((t) => {
          t.classList.remove('applications__tab--active');
          t.setAttribute('aria-selected', 'false');
        });

        panels.forEach((p) => {
          p.classList.remove('applications__panel--active');
        });

        tab.classList.add('applications__tab--active');
        tab.setAttribute('aria-selected', 'true');

        const target = document.querySelector<HTMLElement>(
          `.applications__panel[data-panel="${key}"]`
        );
        if (target) target.classList.add('applications__panel--active');
      });
    });
  }

  document.addEventListener('astro:page-load', initApplications);
</script>