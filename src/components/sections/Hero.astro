---
// src/components/sections/Hero.astro
import type { TranslationKeys } from '../../i18n/en';
import type { Lang } from '../../i18n/utils';
import ScrollReveal from '../ui/ScrollReveal.astro';

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const base = import.meta.env.BASE_URL;
const calculatorHref = lang === 'es' ? `${base}es/#calculator` : `${base}#calculator`;
const materialsHref  = lang === 'es' ? `${base}es/#materials`  : `${base}#materials`;
const sampleHref     = lang === 'es' ? `${base}es/#sample-builder` : `${base}#sample-builder`;
---

<section class="hero">
  <div class="container hero__inner">

    <!-- Left: Copy -->
    <div class="hero__copy">

      <ScrollReveal>
        <div class="hero__badge">
          <span class="hero__badge-dot"></span>
          {t.hero.badge}
        </div>
      </ScrollReveal>

      <ScrollReveal delay={1}>
        <h1 class="hero__title">{t.hero.title}</h1>
      </ScrollReveal>

      <ScrollReveal delay={2}>
        <p class="hero__subtitle">{t.hero.subtitle}</p>
      </ScrollReveal>

      <!-- Action cards -->
      <ScrollReveal delay={3}>
        <div class="hero__cards">
          <a href={calculatorHref} class="hero__card">
            <div class="hero__card-icon hero__card-icon--primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <line x1="8" y1="6" x2="16" y2="6"/>
                <line x1="8" y1="10" x2="16" y2="10"/>
                <line x1="8" y1="14" x2="12" y2="14"/>
              </svg>
            </div>
            <div>
              <span class="hero__card-title">{t.hero.cardCalculator.title}</span>
              <span class="hero__card-desc">{t.hero.cardCalculator.desc}</span>
            </div>
          </a>

          <a href={materialsHref} class="hero__card">
            <div class="hero__card-icon hero__card-icon--accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2v-4M9 21H5a2 2 0 0 1-2-2v-4m0 0h18"/>
              </svg>
            </div>
            <div>
              <span class="hero__card-title">{t.hero.cardMaterials.title}</span>
              <span class="hero__card-desc">{t.hero.cardMaterials.desc}</span>
            </div>
          </a>
        </div>
      </ScrollReveal>

      <!-- Credential badges -->
      <ScrollReveal delay={3}>
        <div class="hero__badges">
          <div class="hero__credential">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>{t.hero.badges.fire}</span>
          </div>
          <div class="hero__credential">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>{t.hero.badges.eco}</span>
          </div>
          <div class="hero__credential">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <span>{t.hero.badges.thermal}</span>
          </div>
        </div>
      </ScrollReveal>

    </div>

    <!-- Right: SVG Panel Visualizer -->
    <ScrollReveal class="hero__visual" delay={2}>
      <div class="hero__visual-card">
        <span class="hero__visual-label">{t.hero.svgLabel}</span>

        <svg viewBox="0 0 500 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero__svg">
          <!-- Upper Steel skin -->
          <path d="M50 120 L150 70 L450 170 L350 220 Z" fill="#E2E8F0" stroke="#4A5568" stroke-width="2"/>
          <!-- Fluting details -->
          <path d="M80 110 L180 60" stroke="#718096" stroke-width="1.5" stroke-dasharray="2 2"/>
          <path d="M120 95 L220 45" stroke="#718096" stroke-width="1.5" stroke-dasharray="2 2"/>
          <path d="M160 80 L260 30" stroke="#718096" stroke-width="1.5" stroke-dasharray="2 2"/>

          <!-- Core faces -->
          <path d="M50 120 L350 220 L350 290 L50 190 Z" fill="#FCE8D1" fill-opacity="0.95"/>
          <path d="M350 220 L450 170 L450 240 L350 290 Z" fill="#EAD2B8" fill-opacity="0.95"/>

          <!-- Core border lines -->
          <path d="M50 120 L350 220" stroke="#E07B39" stroke-width="2.5"/>
          <path d="M50 190 L350 290" stroke="#4A5568" stroke-width="2.5"/>

          <!-- Lower Steel skin -->
          <path d="M50 190 L350 290 L450 240 L150 140 Z" fill="#CBD5E1" stroke="#4A5568" stroke-width="2"/>

          <!-- Callout lines -->
          <line x1="200" y1="200" x2="100" y2="310" stroke="#1C3557" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="200" cy="200" r="4" fill="#E07B39"/>

          <line x1="240" y1="95" x2="360" y2="30" stroke="#1C3557" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="240" cy="95" r="4" fill="#1C3557"/>

          <line x1="270" y1="260" x2="370" y2="340" stroke="#1C3557" stroke-width="1.5" stroke-dasharray="4 4"/>
          <circle cx="270" cy="260" r="4" fill="#1C3557"/>

          <!-- Labels -->
          <rect x="20" y="310" width="155" height="34" rx="4" fill="#1C3557"/>
          <text x="30" y="331" fill="#FFFFFF" font-family="Inter,sans-serif" font-weight="700" font-size="10">{t.hero.svgCore}</text>

          <rect x="295" y="8" width="162" height="34" rx="4" fill="#4A5568"/>
          <text x="305" y="29" fill="#FFFFFF" font-family="Inter,sans-serif" font-weight="700" font-size="10">{t.hero.svgSkin}</text>

          <rect x="295" y="325" width="162" height="34" rx="4" fill="#E07B39"/>
          <text x="305" y="346" fill="#FFFFFF" font-family="Inter,sans-serif" font-weight="700" font-size="10">{t.hero.svgJoint}</text>
        </svg>

        <div class="hero__visual-caption">
          <p>{t.hero.svgCaption}</p>
        </div>
      </div>
    </ScrollReveal>

  </div>
</section>

<style>
  .hero {
    background-color: var(--color-white);
    padding-top: var(--space-10);
    padding-bottom: var(--space-20);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 7fr 5fr;
    }
  }

  /* ── Copy ── */
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ── Badge ── */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    width: fit-content;
  }

  .hero__badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(0.85); }
  }

  /* ── Title ── */
  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* ── Subtitle ── */
  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 36rem;
  }

  /* ── Action Cards ── */
  .hero__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 480px) {
    .hero__cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: all var(--transition-slow);
  }

  .hero__card:hover {
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
    border-color: rgba(224, 123, 57, 0.4);
    transform: translateY(-2px);
  }

  .hero__card-icon {
    padding: var(--space-2);
    border-radius: var(--radius-md);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hero__card-icon--primary {
    background-color: rgba(28, 53, 87, 0.08);
    color: var(--color-primary);
  }

  .hero__card-icon--accent {
    background-color: rgba(224, 123, 57, 0.1);
    color: var(--color-accent);
  }

  .hero__card-title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }

  .hero__card-desc {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: var(--space-1);
    line-height: 1.6;
  }

  /* ── Credential badges ── */
  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .hero__credential {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-steel);
  }

  .hero__credential svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── Visual ── */
  .hero__visual {
    width: 100%;
  }

  .hero__visual-card {
    position: relative;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    transition: box-shadow var(--transition-slow);
  }

  .hero__visual-card:hover {
    box-shadow: var(--shadow-lg), 0 0 0 4px rgba(224, 123, 57, 0.08);
  }

  .hero__visual-label {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-size: 0.625rem;
    font-family: monospace;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .hero__svg {
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    drop-shadow: var(--shadow-md);
  }

  .hero__visual-caption {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
    margin-top: var(--space-2);
  }

  .hero__visual-caption p {
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.7;
    text-align: center;
  }
</style>