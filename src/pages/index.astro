---
import Layout from '../layouts/Layout.astro';
import { getPageI18n } from '../i18n/utils';

const { lang, t, canonicalURL, alternateURL } = getPageI18n(
  Astro.url,
  import.meta.env.BASE_URL
);
---

<Layout t={t} lang={lang} canonicalURL={canonicalURL} alternateURL={alternateURL}>
  <p style="padding: 2rem; color: var(--color-primary); font-weight: 600;">
    ✅ EN index — Lang: {lang}
  </p>
</Layout>