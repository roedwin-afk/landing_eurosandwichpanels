---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Anatomy from '../components/sections/Anatomy.astro';
import Materials from '../components/sections/Materials.astro';
import Calculator from '../components/sections/Calculator.astro';
import Technical from '../components/sections/Technical.astro';
import { getPageI18n } from '../i18n/utils';

const { lang, t, canonicalURL, alternateURL } = getPageI18n(
  Astro.url,
  import.meta.env.BASE_URL
);
---

<Layout t={t} lang={lang} canonicalURL={canonicalURL} alternateURL={alternateURL}>
  <Hero t={t} lang={lang} />
  <Anatomy t={t} />
  <Materials t={t} />
  <Calculator t={t} lang={lang} />
  <Technical t={t} />
</Layout>