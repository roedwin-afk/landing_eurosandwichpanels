---
// src/pages/faq/index.astro
import Layout from '../../layouts/Layout.astro';
import { getPageI18n } from '../../i18n/utils';

const { lang, t, canonicalURL, alternateURL } = getPageI18n(
  Astro.url,
  import.meta.env.BASE_URL
);

const base = import.meta.env.BASE_URL;

// Cast array — necesario por la limitación de DeepString
type FaqItem = { q: string; a: string };
const items = t.faq.items as unknown as FaqItem[];

// Schema JSON-LD FAQPage
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout t={t} lang={lang} canonicalURL={canonicalURL} alternateURL={alternateURL}>

  <!-- JSON-LD FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="faq-hero">
    <div class="container">
      <span class="section-eyebrow">{t.faq.hero.eyebrow}</span>
      <h1 class="faq-hero__title">{t.faq.hero.title}</h1>
      <p class="faq-hero__subtitle">{t.faq.hero.subtitle}</p>
    </div>
  </section>

  <!-- ── ACCORDION ─────────────────────────────────────────────────────── -->
  <section class="section faq-section">
    <div class="container faq-container">
      <div class="faq-list" id="faq-list">
        {items.map((item, i) => (
          <div class="faq-item" data-index={i}>
            <button class="faq-btn" aria-expanded="false">
              <span class="faq-q">{item.q}</span>
              <span class="faq-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
            <div class="faq-body" aria-hidden="true">
              <p class="faq-answer">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section faq-cta-section">
    <div class="container">
      <div class="faq-cta-card">
        <span class="section-eyebrow">{t.faq.cta.eyebrow}</span>
        <h2 class="faq-cta__title">{t.faq.cta.title}</h2>
        <p class="faq-cta__body">{t.faq.cta.body}</p>
        <div class="faq-cta__actions">
          <a href={`${base.replace(/\/$/, '')}${t.faq.cta.href}`} class="btn btn--primary">
            {t.faq.cta.btn}
          </a>
          <a href={`${base.replace(/\/$/, '')}${t.faq.cta.secondaryHref}`} class="btn btn--outline">
            {t.faq.cta.secondary}
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  function initFaq() {
    const list = document.getElementById('faq-list');
    if (!list) return;

    list.querySelectorAll('.faq-btn').forEach((btn) => {
      // Guard para View Transitions — evita listeners duplicados
      if (btn.dataset.faqReady) return;
      btn.dataset.faqReady = '1';

      btn.addEventListener('click', () => {
        const item    = btn.closest('.faq-item');
        const body    = item.querySelector('.faq-body');
        const isOpen  = btn.getAttribute('aria-expanded') === 'true';

        // Cierra todos los demás
        list.querySelectorAll('.faq-item').forEach((el) => {
          if (el === item) return;
          el.querySelector('.faq-btn').setAttribute('aria-expanded', 'false');
          const b = el.querySelector('.faq-body');
          b.style.height = '0px';
          b.setAttribute('aria-hidden', 'true');
          el.classList.remove('faq-item--open');
        });

        // Toggle actual — scrollHeight para la animación
        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          body.style.height = '0px';
          body.setAttribute('aria-hidden', 'true');
          item.classList.remove('faq-item--open');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          body.style.height = body.scrollHeight + 'px';
          body.setAttribute('aria-hidden', 'false');
          item.classList.add('faq-item--open');
        }
      });
    });
  }

  // Astro View Transitions — re-init en cada navegación de página
  document.addEventListener('astro:page-load', initFaq);
</script>

<style>
  /* ── HERO ───────────────────────────────────────────────────────────── */
  .faq-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, #0f2438 100%);
    padding-block: var(--space-20) var(--space-16);
    text-align: center;
  }

  .faq-hero .section-eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    display: block;
  }

  .faq-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.2;
    margin-bottom: var(--space-6);
  }

  .faq-hero__subtitle {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.75);
    /* max-width: 44rem; */
    margin-inline: auto;
    line-height: 1.7;
  }

  /* ── ACCORDION SECTION ──────────────────────────────────────────────── */
  .faq-section {
    background-color: var(--color-bg);
  }

  /* .faq-container {
    max-width: 52rem;
  } */

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .faq-item:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .faq-item--open {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .faq-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6);
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .faq-q {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.5;
    flex: 1;
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform var(--transition);
    display: flex;
    align-items: center;
  }

  .faq-item--open .faq-icon {
    transform: rotate(180deg);
  }

  .faq-body {
    height: 0;
    overflow: hidden;
    transition: height 300ms ease;
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6);
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
  }

  /* ── CTA SECTION ────────────────────────────────────────────────────── */
  .faq-cta-section {
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
  }

  .faq-cta-card {
    background: linear-gradient(135deg, var(--color-primary) 0%, #0f2438 100%);
    border-radius: var(--radius-2xl);
    padding: var(--space-16) var(--space-12);
    text-align: center;
    /* max-width: 44rem; */
    margin-inline: auto;
  }

  .faq-cta-card .section-eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    display: block;
  }

  .faq-cta__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.3;
    margin-bottom: var(--space-4);
  }

  .faq-cta__body {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }

  .faq-cta__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── BUTTONS ────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition), color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }

  .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-white);
    border: 2px solid transparent;
  }

  .btn--primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn--outline {
    background-color: transparent;
    color: var(--color-white);
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .btn--outline:hover {
    border-color: var(--color-white);
    background-color: rgba(255, 255, 255, 0.1);
  }

  /* ── RESPONSIVE ─────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .faq-cta-card {
      padding: var(--space-10) var(--space-6);
    }

    .faq-btn {
      padding: var(--space-4) var(--space-4);
    }

    .faq-answer {
      padding: 0 var(--space-4) var(--space-4);
    }
  }
</style>