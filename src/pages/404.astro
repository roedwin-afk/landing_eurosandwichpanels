---
import Layout from '../layouts/Layout.astro';
import { getPageI18n } from '../i18n/utils';

const { lang, t, canonicalURL, alternateURL } = getPageI18n(
  Astro.url,
  import.meta.env.BASE_URL
);

const base = import.meta.env.BASE_URL;
const homeHref         = lang === 'es' ? `${base}es/`                : base;
const applicationsHref = lang === 'es' ? `${base}es/applications/`   : `${base}applications/`;
const installationHref = lang === 'es' ? `${base}es/installation/`   : `${base}installation/`;
const calculatorHref   = lang === 'es' ? `${base}es/#calculator`     : `${base}#calculator`;
---

<Layout t={t} lang={lang} canonicalURL={canonicalURL} alternateURL={alternateURL}>
  <section class="not-found">
    <div class="container not-found__inner">

      <!-- Code -->
      <div class="not-found__code" aria-hidden="true">404</div>

      <!-- Copy -->
      <div class="not-found__copy">
        <h1 class="not-found__title">
          { lang === 'es' ? 'Página no encontrada' : 'Page not found' }
        </h1>
        <p class="not-found__desc">
          { lang === 'es'
            ? 'La página que buscas no existe o ha sido movida. Aquí tienes algunos recursos útiles para continuar.'
            : 'The page you are looking for does not exist or has been moved. Here are some useful resources to continue.'
          }
        </p>
      </div>

      <!-- Links -->
      <nav class="not-found__links" aria-label="Helpful links">

        <a href={homeHref} class="not-found__link not-found__link--primary">
          <span class="not-found__link-icon">🏠</span>
          <div>
            <span class="not-found__link-title">
              { lang === 'es' ? 'Inicio' : 'Home' }
            </span>
            <span class="not-found__link-desc">
              { lang === 'es' ? 'Volver a la página principal' : 'Back to the main page' }
            </span>
          </div>
        </a>

        <a href={applicationsHref} class="not-found__link">
          <span class="not-found__link-icon">🏭</span>
          <div>
            <span class="not-found__link-title">
              { lang === 'es' ? 'Aplicaciones' : 'Applications' }
            </span>
            <span class="not-found__link-desc">
              { lang === 'es' ? 'Paneles por sector industrial' : 'Panels by industry sector' }
            </span>
          </div>
        </a>

        <a href={installationHref} class="not-found__link">
          <span class="not-found__link-icon">🔧</span>
          <div>
            <span class="not-found__link-title">
              { lang === 'es' ? 'Instalación' : 'Installation' }
            </span>
            <span class="not-found__link-desc">
              { lang === 'es' ? 'Guía técnica paso a paso' : 'Step by step technical guide' }
            </span>
          </div>
        </a>

        <a href={calculatorHref} class="not-found__link">
          <span class="not-found__link-icon">🧮</span>
          <div>
            <span class="not-found__link-title">
              { lang === 'es' ? 'Calculadora' : 'Calculator' }
            </span>
            <span class="not-found__link-desc">
              { lang === 'es' ? 'Calcula tu U-value' : 'Calculate your U-value' }
            </span>
          </div>
        </a>

      </nav>

    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    background-color: var(--color-bg);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
    padding-block: var(--space-20);
  }

  /* ── Code ── */
  .not-found__code {
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 800;
    color: var(--color-border);
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
  }

  /* ── Copy ── */
  .not-found__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .not-found__title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.3;
  }

  .not-found__desc {
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: 1.8;
  }

  /* ── Links ── */
  .not-found__links {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    width: 100%;
    max-width: 36rem;
  }

  @media (min-width: 480px) {
    .not-found__links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .not-found__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-align: left;
    transition: all var(--transition-slow);
  }

  .not-found__link:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .not-found__link--primary {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
  }

  .not-found__link--primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .not-found__link--primary .not-found__link-title {
    color: var(--color-white);
  }

  .not-found__link--primary .not-found__link-desc {
    color: rgba(255, 255, 255, 0.6);
  }

  .not-found__link-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .not-found__link-title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .not-found__link-desc {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-top: 2px;
  }
</style>