  }

  /* Override NavLinks styles inside footer */
  .footer__col :global(.nav-link) {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    padding-block: var(--space-1);
    padding-inline: 0;
    background: none !important;
  }

  .footer__col :global(.nav-link:hover) {
