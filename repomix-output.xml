// src/components/ui/NavLinks.astro
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
    t: TranslationKeys;
    lang: Lang;
    orientation?: "horizontal" | "vertical";
    onClickClose?: boolean;
}

const {
    t,
    lang,
    orientation = "horizontal",
    onClickClose = false,
} = Astro.props;

const base = lang === "es" ? "/es" : "";

const links = [
  { href: `${base}/#what-is-it`,     label: t.nav.what },
  { href: `${base}/#materials`,      label: t.nav.materials },
  { href: `${base}/#calculator`,     label: t.nav.calculator },
];
---

<ul
    class:list={[
        "nav-links",
        orientation === "vertical"
            ? "nav-links--vertical"
            : "nav-links--horizontal",
    ]}
>
    {
        links.map((link) => (
            <li>
                <a
                    href={link.href}
                    class="nav-link"
                    data-close={onClickClose ? "true" : undefined}
                >
                    {link.label}
                </a>
            </li>
        ))
    }
</ul>

<style>
    .nav-links {
        display: flex;
        gap: var(--space-8);
        align-items: center;
    }

    .nav-links--vertical {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
    }

    .nav-links--horizontal {
        flex-direction: row;
    }

    .nav-link {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-steel);
        transition: color var(--transition);
        padding-block: var(--space-1);
        position: relative;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 2px;
        background-color: var(--color-accent);
        transition: width var(--transition);
    }

    .nav-link:hover {
        color: var(--color-primary);
    }

    .nav-link:hover::after {
        width: 100%;
    }

    /* Vertical variant: sin underline animado, más espaciado */
    .nav-links--vertical .nav-link {
        font-size: var(--text-base);
        padding-block: var(--space-2);
        padding-inline: var(--space-2);
        width: 100%;
        display: block;
        border-radius: var(--radius-md);
    }

    .nav-links--vertical .nav-link:hover {
        background-color: var(--color-bg);
    }

    .nav-links--vertical .nav-link::after {
        display: none;
    }
</style>
</file>

<file path="src/components/ui/ScrollReveal.astro">
---
// src/components/ui/ScrollReveal.astro
// Componente wrapper que aplica animación reveal a sus hijos.

interface Props {
  delay?: 0 | 1 | 2 | 3;
  class?: string;
  tag?: 'div' | 'section' | 'article' | 'li' | 'span';
}

const {
  delay = 0,
  class: className = '',
  tag: Tag = 'div',
} = Astro.props;

const delayClass = delay > 0 ? `reveal-delay-${delay}` : '';
---

<Tag class:list={['reveal', delayClass, className]}>
  <slot />
</Tag>

<script>
  function initScrollReveal() {
    const elements = document.querySelectorAll<HTMLElement>('.reveal');

    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            // Una vez visible, dejamos de observar
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -48px 0px',
      }
    );

    elements.forEach((el) => observer.observe(el));
  }

  // Inicializar en carga normal y tras View Transitions
  document.addEventListener('astro:page-load', initScrollReveal);
</script>
</file>

